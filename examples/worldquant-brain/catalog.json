    {"name": "ts_mean", "arity": {"kind": "binary"}, "inputs": [{"kinds": ["signal"]}, {"kinds": ["scalar"], "domain": {"kind": "window_set", "values": [5, 10, 20, 60]}}], "output": "signal", "generation_weight": 3},
    {"name": "ts_delta", "arity": {"kind": "binary"}, "inputs": [{"kinds": ["signal"]}, {"kinds": ["scalar"], "domain": {"kind": "window_set", "values": [5, 10, 20, 60]}}], "output": "signal", "generation_weight": 3},
    {"name": "subtract", "arity": {"kind": "binary"}, "inputs": [{"kinds": ["signal"]}, {"kinds": ["signal"]}], "output": "signal", "generation_weight": 1},
    {"name": "multiply", "arity": {"kind": "variadic", "min": 2, "max": 8}, "inputs": [{"kinds": ["signal", "scalar"]}], "required_input_kinds": ["signal"], "output": "signal", "commutative": true, "associative": true, "generation_weight": 1}
