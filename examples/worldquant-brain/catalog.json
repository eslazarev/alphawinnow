    {"name": "volume", "kind": "signal", "family": "toy-volume", "allowed_roles": ["signal_input"]},
    {"name": "returns", "kind": "signal", "family": "toy-return", "allowed_roles": ["signal_input"]}
  ],
  "groups": [{"name": "sector", "kind": "group"}],
