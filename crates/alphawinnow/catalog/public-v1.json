    { "name": "ts_rank", "arity": { "kind": "binary" }, "inputs": [{ "kinds": ["signal"] }, { "kinds": ["scalar"], "domain": { "kind": "window", "min": 2, "max": 512 } }], "output": "signal", "generation_weight": 3 },
    { "name": "ts_mean", "arity": { "kind": "binary" }, "inputs": [{ "kinds": ["signal"] }, { "kinds": ["scalar"], "domain": { "kind": "window", "min": 2, "max": 512 } }], "output": "signal", "generation_weight": 3 },
    { "name": "ts_std_dev", "arity": { "kind": "binary" }, "inputs": [{ "kinds": ["signal"] }, { "kinds": ["scalar"], "domain": { "kind": "window", "min": 2, "max": 512 } }], "output": "signal", "generation_weight": 2 },
    { "name": "ts_zscore", "arity": { "kind": "binary" }, "inputs": [{ "kinds": ["signal"] }, { "kinds": ["scalar"], "domain": { "kind": "window", "min": 2, "max": 512 } }], "output": "signal", "generation_weight": 3 },
    { "name": "ts_delta", "arity": { "kind": "binary" }, "inputs": [{ "kinds": ["signal"] }, { "kinds": ["scalar"], "domain": { "kind": "window", "min": 2, "max": 512 } }], "output": "signal", "generation_weight": 3 },
