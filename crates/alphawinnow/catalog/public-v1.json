    { "name": "divide", "arity": { "kind": "binary" }, "inputs": [{ "kinds": ["signal"] }, { "kinds": ["scalar"], "domain": { "kind": "non_zero_scalar" } }], "output": "signal", "generation_weight": 1 },
    { "name": "greater", "arity": { "kind": "binary" }, "inputs": [{ "kinds": ["signal"] }, { "kinds": ["scalar"] }], "output": "boolean", "generation_weight": 2 },
    { "name": "group_rank", "arity": { "kind": "binary" }, "inputs": [{ "kinds": ["signal"] }, { "kinds": ["group"] }], "output": "signal", "generation_weight": 2 },
    { "name": "add", "arity": { "kind": "variadic", "min": 2, "max": 8 }, "inputs": [{ "kinds": ["signal"] }], "required_input_kinds": ["signal"], "output": "signal", "commutative": true, "associative": true, "generation_weight": 2 },
    { "name": "multiply", "arity": { "kind": "variadic", "min": 2, "max": 8 }, "inputs": [{ "kinds": ["signal", "scalar"] }], "required_input_kinds": ["signal"], "output": "signal", "commutative": true, "associative": true, "generation_weight": 2 },
    { "name": "if_else", "arity": { "kind": "exact", "count": 3 }, "inputs": [{ "kinds": ["boolean"] }, { "kinds": ["signal"] }, { "kinds": ["signal"] }], "output": "signal", "generation_weight": 2 },
    { "name": "winsorize", "arity": { "kind": "unary" }, "inputs": [{ "kinds": ["signal"] }], "output": "signal", "keywords": [{ "name": "std", "min": 0.1, "max": 10.0, "step": 0.1 }], "generation_weight": 2 },
    { "name": "clip", "arity": { "kind": "unary" }, "inputs": [{ "kinds": ["signal"] }], "output": "signal", "keywords": [{ "name": "lower", "min": -100.0, "max": 100.0, "step": 0.1 }, { "name": "upper", "min": -100.0, "max": 100.0, "step": 0.1 }], "keyword_constraints": [{ "kind": "less_than", "left": "lower", "right": "upper" }], "generation_weight": 1 }
